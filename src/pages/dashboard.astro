---
export const prerender = false;

import { isAdminAuthed } from '../lib/admin-auth';
import { getEnv } from '../lib/env';
import { isMariaEmailLive } from '../lib/launch-status';
import {
  COMMISSION_RATE,
  canLeadAcceptMorePayments,
  commissionForAmount,
  formatEuro,
  formatShortDate,
  getMomentoLabel,
} from '../lib/leads';
import {
  PAYMENT_PRESETS,
  PROGRAM_PRICING,
  formatMonthLabel,
  leadCaptureMonth,
} from '../lib/pricing';
import { platoCompraMonth } from '../lib/plato-compras';
import { fetchLeadsWithPagos, fetchPlatoCompras } from '../lib/supabase';

const mesActual = new Date().toISOString().slice(0, 7);

const authed = isAdminAuthed(Astro.cookies);
const adminConfigured = Boolean(getEnv('ADMIN_PASSWORD'));
const mariaEmailLive = isMariaEmailLive();
const stripeWebhookConfigured = Boolean(
  getEnv('STRIPE_SECRET_KEY') && getEnv('STRIPE_WEBHOOK_SECRET'),
);

const mesQuery = Astro.url.searchParams.get('mes');
const selectedMes =
  mesQuery && /^\d{4}-\d{2}$/.test(mesQuery) ? mesQuery : mesActual;
const mesLabel = formatMonthLabel(selectedMes);

let leads: Awaited<ReturnType<typeof fetchLeadsWithPagos>> = [];
let platoCompras: Awaited<ReturnType<typeof fetchPlatoCompras>> = [];
let loadError: string | null = null;

if (authed) {
  try {
    const [leadsResult, platoResult] = await Promise.all([
      fetchLeadsWithPagos(),
      fetchPlatoCompras(),
    ]);
    leads = leadsResult;
    platoCompras = platoResult;
  } catch {
    loadError =
      'No se pudieron cargar los datos. Revisa Supabase y las variables de entorno.';
  }
}

const leadsDelMes = leads
  .filter((l) => leadCaptureMonth(l.created_at) === selectedMes)
  .sort(
    (a, b) =>
      new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
  );

const leadsPendientesCobro = leadsDelMes.filter(
  (l) =>
    canLeadAcceptMorePayments(l.pagos) &&
    !l.pagos.some((p) => p.mes === selectedMes),
);

const cobrosDelMes = leads.flatMap((lead) =>
  lead.pagos
    .filter((p) => p.mes === selectedMes)
    .map((p) => ({
      ...p,
      lead_nombre: lead.nombre,
      lead_id: lead.id,
    })),
);

const totalCobrado = cobrosDelMes.reduce(
  (sum, p) => sum + Number(p.importe),
  0,
);
const comisionMes = commissionForAmount(totalCobrado);
const clientasConPago = new Set(cobrosDelMes.map((p) => p.lead_id)).size;

const platoDelMes = platoCompras.filter(
  (c) => platoCompraMonth(c.created_at) === selectedMes,
);
const totalPlatoMes = platoDelMes.reduce(
  (sum, c) => sum + Number(c.importe),
  0,
);
const totalPlatoHistorico = platoCompras.reduce(
  (sum, c) => sum + Number(c.importe),
  0,
);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dashboard — Embarazafit</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap"
    />
  </head>
  <body>
    <div class="admin-wrap">
      <header class="admin-header">
        <h1>Dashboard</h1>
        {
          authed && (
            <button type="button" id="logout-btn" class="btn-secondary">
              Cerrar sesión
            </button>
          )
        }
      </header>

      {
        !adminConfigured ? (
          <section class="card">
            <h2>Configuración pendiente</h2>
            <p>
              Añade <code>ADMIN_PASSWORD</code> en <code>.env</code> o Vercel.
            </p>
          </section>
        ) : !authed ? (
          <section class="card">
            <h2>Acceso privado</h2>
            <p id="login-error" class="error-msg" hidden />
            <form id="login-form">
              <label for="password">Contraseña</label>
              <input type="password" id="password" required />
              <button type="submit" class="btn-primary">Entrar</button>
            </form>
          </section>
        ) : loadError ? (
          <p class="error-msg">{loadError}</p>
        ) : (
          <>
            {!mariaEmailLive && (
              <section class="banner-warn" role="status">
                <strong>Modo prueba:</strong> el email de María aún no está
                activado. Ver <code>docs/CONSULTA-NUTRICIONISTA.md</code>.
              </section>
            )}

            <form method="get" class="month-bar card">
              <label for="mes">Ver mes</label>
              <input
                type="month"
                id="mes"
                name="mes"
                value={selectedMes}
                onchange="this.form.submit()"
              />
              <span class="month-hint">{mesLabel}</span>
            </form>

            <section class="income-overview" aria-label="Resumen de ingresos">
              <article class="card income-tile income-tile--maria">
                <p class="income-tile-label">Colaboración con María</p>
                <p class="income-tile-value">{formatEuro(comisionMes)}</p>
                <p class="income-tile-note">
                  Tu comisión del {Math.round(COMMISSION_RATE * 100)}% en{' '}
                  {mesLabel}
                </p>
              </article>
              <article class="card income-tile income-tile--plato">
                <p class="income-tile-label">Simulador del Plato</p>
                <p class="income-tile-value">{formatEuro(totalPlatoMes)}</p>
                <p class="income-tile-note">
                  {platoDelMes.length}{' '}
                  {platoDelMes.length === 1 ? 'venta' : 'ventas'} en {mesLabel}
                </p>
              </article>
            </section>

            <h2 class="section-divider" id="seccion-plato">
              Ingresos · Simulador del Plato
            </h2>

            {
              !stripeWebhookConfigured && (
                <section class="banner-warn" role="status">
                  <strong>Stripe pendiente:</strong> añade{' '}
                  <code>STRIPE_SECRET_KEY</code> y{' '}
                  <code>STRIPE_WEBHOOK_SECRET</code> en Vercel. Guía en{' '}
                  <code>docs/PLATO-INTERACTIVO.md</code>.
                </section>
              )
            }

            <section class="card plato-card">
              <h2>Ventas del Plato en {mesLabel}</h2>
              <p class="big-number big-number--coral">
                {formatEuro(totalPlatoMes)}
              </p>
              <p class="sub-note">Ingresos brutos (antes de comisión Stripe)</p>
              <ul class="stats-row">
                <li>
                  <strong>{platoDelMes.length}</strong>{' '}
                  {platoDelMes.length === 1 ? 'compra' : 'compras'} este mes
                </li>
                <li>
                  <strong>{formatEuro(totalPlatoHistorico)}</strong> acumulado
                  histórico
                </li>
                <li>
                  <strong>{platoCompras.length}</strong> ventas totales
                </li>
              </ul>

              {
                platoDelMes.length === 0 ? (
                  <p class="empty">
                    Ninguna compra del Plato este mes. Cuando alguien pague por
                    Stripe, aparecerá aquí automáticamente.
                  </p>
                ) : (
                  <div class="table-wrap">
                    <table class="leads-table">
                      <thead>
                        <tr>
                          <th scope="col">Fecha</th>
                          <th scope="col">Email</th>
                          <th scope="col">Nombre</th>
                          <th scope="col">Importe</th>
                        </tr>
                      </thead>
                      <tbody>
                        {platoDelMes.map((c) => (
                          <tr>
                            <td>{formatShortDate(c.created_at)}</td>
                            <td>{c.email || '—'}</td>
                            <td>{c.customer_name || '—'}</td>
                            <td>{formatEuro(Number(c.importe))}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )
              }
            </section>

            <h2 class="section-divider" id="seccion-maria">
              Ingresos · Colaboración con María
            </h2>

            <section class="card workflow-card">
              <h2>Cómo trabajar con María</h2>
              <ol>
                <li>
                  Las chicas rellenan el formulario → aparecen abajo como{' '}
                  <strong>leads captados</strong>.
                </li>
                <li>
                  A fin de mes, le pasas a María la lista de leads de ese mes.
                </li>
                <li>
                  María te dice quién ha contratado su consulta (le han pagado a
                  ella por Bizum) y cuánto ha cobrado de cada una.
                </li>
                <li>
                  Registras aquí esos cobros → el dashboard calcula tu{' '}
                  <strong>{Math.round(COMMISSION_RATE * 100)}%</strong> sobre lo
                  que María ha cobrado.
                </li>
              </ol>
            </section>

            <details class="card pricing-card">
              <summary>Precios del programa (referencia)</summary>
              <div class="pricing-grid">
                <div>
                  <h3>Pago único (Bizum)</h3>
                  <p>
                    <strong>Lanzamiento</strong> (1.er mes):{' '}
                    {formatEuro(PROGRAM_PRICING.completo.lanzamiento)}
                  </p>
                  <p>
                    <strong>Oficial:</strong>{' '}
                    {formatEuro(PROGRAM_PRICING.completo.oficial)}
                  </p>
                </div>
                <div>
                  <h3>Pago en 2 cuotas (+{PROGRAM_PRICING.extraAplazado})</h3>
                  <p>
                    Lanzamiento: {formatEuro(PROGRAM_PRICING.aplazado.lanzamiento.total)}{' '}
                    → 2 × {formatEuro(PROGRAM_PRICING.aplazado.lanzamiento.cuota)}
                  </p>
                  <p>
                    Oficial: {formatEuro(PROGRAM_PRICING.aplazado.oficial.total)} →
                    2 × {formatEuro(PROGRAM_PRICING.aplazado.oficial.cuota)}
                  </p>
                </div>
              </div>
            </details>

            <section class="card commission-card">
              <h2>Tu comisión por María en {mesLabel}</h2>
              <p class="big-number">{formatEuro(comisionMes)}</p>
              <p class="sub-note">
                Tu {Math.round(COMMISSION_RATE * 100)}% sobre lo cobrado por María
                (no es ingreso del Plato)
              </p>
              <ul class="stats-row">
                <li>
                  <strong>{formatEuro(totalCobrado)}</strong> cobrado por María
                </li>
                <li>
                  <strong>{cobrosDelMes.length}</strong>{' '}
                  {cobrosDelMes.length === 1
                    ? 'pago registrado'
                    : 'pagos registrados'}
                </li>
                <li>
                  <strong>{clientasConPago}</strong> clienta
                  {clientasConPago === 1 ? '' : 's'}
                </li>
              </ul>
              {
                cobrosDelMes.length > 0 && (
                  <ul class="cobros-list">
                    {cobrosDelMes.map((p) => (
                      <li>
                        {p.lead_nombre} — {formatEuro(Number(p.importe))}
                        {p.tipo === 'fraccionado' ? ' (cuota)' : ' (completo)'}
                        → tu parte:{' '}
                        {formatEuro(commissionForAmount(Number(p.importe)))}
                      </li>
                    ))}
                  </ul>
                )
              }

              <h3>Registrar un cobro que María te ha confirmado</h3>
              <p class="help-text">
                Solo leads de {mesLabel} sin cobro ya registrado este mes. Cada
                clienta: un pago único o hasta 2 cuotas (una por mes).
              </p>
              <form id="cobro-global-form" class="cobro-form">
                <input type="hidden" name="mes" value={selectedMes} />
                <label>
                  Lead de este mes
                  <select
                    name="lead_id"
                    required
                    disabled={leadsPendientesCobro.length === 0}
                  >
                    <option value="">
                      {leadsDelMes.length === 0
                        ? 'No hay leads este mes'
                        : leadsPendientesCobro.length === 0
                          ? 'Todas tienen cobro registrado'
                          : 'Elige una lead…'}
                    </option>
                    {leadsPendientesCobro.map((l) => (
                      <option value={l.id}>{l.nombre}</option>
                    ))}
                  </select>
                </label>
                <label>
                  Qué ha pagado
                  <select name="preset" required>
                    <option value="">Elige el importe…</option>
                    {PAYMENT_PRESETS.map((p) => (
                      <option
                        value={p.id}
                        data-importe={p.importe}
                        data-tipo={p.tipo}
                      >
                        {p.label}
                      </option>
                    ))}
                  </select>
                </label>
                <button type="submit" class="btn-secondary">
                  Guardar cobro
                </button>
              </form>
            </section>

            <section class="card leads-export-card">
              <h2>
                Leads captados en {mesLabel} ({leadsDelMes.length})
              </h2>
              <p class="help-text">
                Captura esta tabla para enviársela a María a fin de mes.
              </p>
              {
                leadsDelMes.length === 0 ? (
                  <p class="empty">Ningún lead este mes.</p>
                ) : (
                  <div class="table-wrap">
                    <table class="leads-table" id="leads-table">
                      <thead>
                        <tr>
                          <th scope="col">#</th>
                          <th
                            class="sortable sort-asc"
                            data-sort="fecha"
                            scope="col"
                            aria-sort="ascending"
                          >
                            Fecha
                          </th>
                          <th class="sortable" data-sort="nombre" scope="col">
                            Nombre
                          </th>
                          <th scope="col">Teléfono</th>
                          <th scope="col">Email</th>
                          <th scope="col">Momento</th>
                          <th scope="col">Notas</th>
                        </tr>
                      </thead>
                      <tbody>
                        {leadsDelMes.map((lead, i) => (
                          <tr
                            data-fecha={lead.created_at}
                            data-nombre={lead.nombre}
                          >
                            <td>{i + 1}</td>
                            <td>{formatShortDate(lead.created_at)}</td>
                            <td>{lead.nombre}</td>
                            <td>{lead.telefono}</td>
                            <td>{lead.email}</td>
                            <td>{getMomentoLabel(lead.momento)}</td>
                            <td>{lead.situacion || '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )
              }
            </section>
          </>
        )
      }
    </div>

    <script>
      import { getPresetById } from '../lib/pricing';

      const loginForm = document.getElementById('login-form');
      const loginError = document.getElementById('login-error');
      const logoutBtn = document.getElementById('logout-btn');

      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const password = (document.getElementById('password') as HTMLInputElement)
          .value;
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        if (res.ok) window.location.reload();
        else if (loginError) {
          loginError.textContent = 'Contraseña incorrecta';
          loginError.hidden = false;
        }
      });

      logoutBtn?.addEventListener('click', async () => {
        await fetch('/api/admin/logout', { method: 'POST' });
        window.location.reload();
      });

      async function submitCobro(
        leadId: string,
        mes: string,
        presetId: string,
      ) {
        const preset = getPresetById(presetId);
        if (!preset) {
          alert('Elige un importe válido');
          return;
        }
        const res = await fetch('/api/admin/pagos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lead_id: leadId,
            mes,
            importe: preset.importe,
            tipo: preset.tipo,
          }),
        });
        if (res.ok) window.location.reload();
        else {
          const body = await res.json().catch(() => ({}));
          alert((body as { error?: string }).error || 'No se pudo guardar');
        }
      }

      document
        .getElementById('cobro-global-form')
        ?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const fd = new FormData(e.target as HTMLFormElement);
          await submitCobro(
            fd.get('lead_id') as string,
            fd.get('mes') as string,
            fd.get('preset') as string,
          );
        });

      const leadsTable = document.getElementById('leads-table');
      if (leadsTable) {
        const tbody = leadsTable.querySelector('tbody');
        const headers = leadsTable.querySelectorAll<HTMLTableCellElement>(
          'th[data-sort]',
        );
        let activeKey = 'fecha';
        let activeDir: 'asc' | 'desc' = 'asc';

        function compareRows(
          a: HTMLTableRowElement,
          b: HTMLTableRowElement,
          key: string,
          dir: 'asc' | 'desc',
        ) {
          let cmp = 0;
          if (key === 'fecha') {
            cmp = (a.dataset.fecha ?? '').localeCompare(b.dataset.fecha ?? '');
          } else {
            const av = (a.dataset.nombre ?? '').toLocaleLowerCase('es');
            const bv = (b.dataset.nombre ?? '').toLocaleLowerCase('es');
            cmp = av.localeCompare(bv, 'es', { sensitivity: 'base' });
          }
          return dir === 'asc' ? cmp : -cmp;
        }

        function renumberRows() {
          tbody
            ?.querySelectorAll<HTMLTableRowElement>('tr')
            .forEach((row, i) => {
              const numCell = row.querySelector('td');
              if (numCell) numCell.textContent = String(i + 1);
            });
        }

        function updateHeaderState(activeHeader: HTMLTableCellElement) {
          headers.forEach((h) => {
            const isActive = h === activeHeader;
            h.classList.toggle('sort-asc', isActive && activeDir === 'asc');
            h.classList.toggle('sort-desc', isActive && activeDir === 'desc');
            h.setAttribute(
              'aria-sort',
              isActive
                ? activeDir === 'asc'
                  ? 'ascending'
                  : 'descending'
                : 'none',
            );
          });
        }

        function sortTable(key: string, header: HTMLTableCellElement) {
          if (!tbody) return;

          if (activeKey === key) {
            activeDir = activeDir === 'asc' ? 'desc' : 'asc';
          } else {
            activeKey = key;
            activeDir = 'asc';
          }

          const rows = Array.from(
            tbody.querySelectorAll<HTMLTableRowElement>('tr'),
          );
          rows.sort((a, b) => compareRows(a, b, key, activeDir));
          rows.forEach((row) => tbody.appendChild(row));
          renumberRows();
          updateHeaderState(header);
        }

        headers.forEach((header) => {
          header.addEventListener('click', () => {
            const key = header.dataset.sort;
            if (key) sortTable(key, header);
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --pale-sand: #f7f4ef;
    --dark-charcoal: #2e3033;
    --vibrant-coral: #f76f5e;
    --deep-teal: #32a398;
  }

  body {
    font-family: 'Poppins', sans-serif;
    margin: 0;
    background: var(--pale-sand);
    color: var(--dark-charcoal);
    line-height: 1.5;
  }

  .admin-wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 20px 16px 48px;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .admin-header h1 {
    margin: 0;
    color: var(--deep-teal);
    font-size: 1.5rem;
  }

  .card {
    background: #fff;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .card h2 {
    margin: 0 0 12px;
    font-size: 1.15rem;
  }

  .card h3 {
    margin: 16px 0 8px;
    font-size: 1rem;
    color: var(--deep-teal);
  }

  .month-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .month-bar label {
    font-weight: bold;
  }

  .month-bar input[type='month'] {
    padding: 8px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-family: inherit;
  }

  .month-hint {
    color: var(--deep-teal);
    font-weight: bold;
  }

  .workflow-card ol {
    margin: 0;
    padding-left: 20px;
  }

  .workflow-card li {
    margin-bottom: 8px;
  }

  .pricing-card summary {
    cursor: pointer;
    font-weight: bold;
    color: var(--deep-teal);
  }

  .pricing-grid {
    display: grid;
    gap: 16px;
    margin-top: 12px;
  }

  @media (min-width: 500px) {
    .pricing-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pricing-grid h3 {
    margin-top: 0;
    font-size: 0.95rem;
  }

  .pricing-grid p {
    margin: 4px 0;
    font-size: 0.9rem;
  }

  .commission-card {
    border-left: 4px solid var(--deep-teal);
  }

  .section-divider {
    margin: 28px 0 12px;
    font-size: 1.05rem;
    color: var(--dark-charcoal);
    border-bottom: 2px solid rgba(50, 163, 152, 0.25);
    padding-bottom: 8px;
  }

  .income-overview {
    display: grid;
    gap: 12px;
    margin-bottom: 8px;
  }

  @media (min-width: 560px) {
    .income-overview {
      grid-template-columns: 1fr 1fr;
    }
  }

  .income-tile {
    margin-bottom: 0;
  }

  .income-tile--maria {
    border-left: 4px solid var(--deep-teal);
  }

  .income-tile--plato {
    border-left: 4px solid var(--vibrant-coral);
  }

  .income-tile-label {
    margin: 0 0 6px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.75;
  }

  .income-tile-value {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--deep-teal);
  }

  .income-tile--plato .income-tile-value {
    color: var(--vibrant-coral);
  }

  .income-tile-note {
    margin: 6px 0 0;
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .plato-card {
    border-left: 4px solid var(--vibrant-coral);
  }

  .big-number--coral {
    color: var(--vibrant-coral);
  }

  .big-number {
    font-size: 2rem;
    font-weight: bold;
    color: var(--deep-teal);
    margin: 0;
  }

  .sub-note {
    margin: 0 0 12px;
    opacity: 0.8;
  }

  .stats-row {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    font-size: 0.9rem;
  }

  .cobros-list {
    margin: 0 0 16px;
    padding-left: 18px;
    font-size: 0.9rem;
  }

  .help-text {
    font-size: 0.9rem;
    opacity: 0.85;
    margin: 0 0 12px;
  }

  .cobro-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cobro-form label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.9rem;
    font-weight: bold;
  }

