---
import Layout from '../layouts/Layout.astro';
import PlatoPremiumGate from '../components/PlatoPremiumGate.astro';
import PlatoInteractivo from '../components/PlatoInteractivo.astro';
import {
  PLATO_ACCESS_PARAM,
  PLATO_PREMIUM_COOKIE,
  PLATO_PREMIUM_PARAM,
  PLATO_SESSION_PARAM,
} from '../lib/plato-config';

/**
 * Acceso premium (solo cliente):
 * - Cookie existente
 * - ?session_id=cs_… (Stripe success) → valida en API
 * - ?acceso=TOKEN (email) → valida en API
 * - Evento plato:unlock («Ya compré»)
 *
 * ?premium=true ya NO otorga acceso (agujero del MVP cerrado).
 */
---

<Layout
  title="Simulador del Plato | Embarazafit"
  description="Construye tu plato 50-25-25 con evidencia científica para controlar la diabetes gestacional. Herramienta premium interactiva."
>
  <style>
    :global(main) {
      max-width: 1000px;
      padding: 0 16px;
    }

    .plato-page {
      padding: 32px 0 56px;
    }

    .plato-header {
      margin-bottom: 32px;
      text-align: center;
    }

    .plato-header__label {
      display: inline-block;
      margin-bottom: 10px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #32a398;
      background: #32a39815;
      border-radius: 20px;
      padding: 3px 14px;
    }

    .plato-header h1 {
      margin: 0 0 10px;
      font-size: clamp(1.5rem, 5vw, 2rem);
      color: #2e3033;
      line-height: 1.2;
    }

    .plato-header p {
      max-width: 540px;
      margin: 0 auto;
      font-size: 1rem;
      line-height: 1.65;
      color: #2e303399;
    }

    #plato-loading {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 220px;
      color: #2e303360;
      font-size: 0.9rem;
    }

    #plato-access-error {
      max-width: 28rem;
      margin: 0 auto 24px;
      padding: 12px 16px;
      border-radius: 10px;
      background: #fef3f2;
      border: 1px solid #fecdca;
      color: #b42318;
      font-size: 0.9rem;
      line-height: 1.5;
      text-align: center;
    }
  </style>

  <div class="plato-page">
    <header class="plato-header">
      <span class="plato-header__label">⭐ Herramienta Premium</span>
      <h1>Simulador del Plato<br />para Diabetes Gestacional</h1>
      <p>
        Arma tu plato con la estructura 50-25-25 basada en evidencia para
        controlar los picos de glucosa en ayunas y tras las comidas.
      </p>
    </header>

    <div id="plato-loading" aria-hidden="true">
      <span>Cargando…</span>
    </div>

    <div id="plato-content" hidden>
      <p id="plato-access-error" hidden role="alert"></p>
      <div id="plato-simulator" hidden>
        <PlatoInteractivo />
      </div>
      <div id="plato-gate">
        <PlatoPremiumGate />
      </div>
    </div>
  </div>
</Layout>

<script
  define:vars={{
    PLATO_PREMIUM_COOKIE,
    PLATO_PREMIUM_PARAM,
    PLATO_SESSION_PARAM,
    PLATO_ACCESS_PARAM,
  }}
>
  /**
   * 1. Cookie → acceso
   * 2. ?session_id=… → POST /api/plato/verify-session → cookie
   * 3. ?acceso=TOKEN → POST /api/plato/access → cookie
   * 4. plato:unlock («Ya compré») → cookie
   * ?premium=true se ignora (solo se limpia de la URL)
   */

  const COOKIE_NAME = PLATO_PREMIUM_COOKIE;
  const COOKIE_DAYS = 3650;

  function getCookie(name) {
    return document.cookie.split('; ').reduce((acc, pair) => {
      const [k, v] = pair.split('=');
      return k === name ? decodeURIComponent(v) : acc;
    }, '');
  }

  function setCookie(name, value, days) {
    const expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=/; SameSite=Lax`;
  }

  function cleanAccessParams() {
    const url = new URL(location.href);
    let changed = false;
    for (const key of [
      PLATO_PREMIUM_PARAM,
      PLATO_SESSION_PARAM,
      PLATO_ACCESS_PARAM,
    ]) {
      if (url.searchParams.has(key)) {
        url.searchParams.delete(key);
        changed = true;
      }
    }
    if (changed) {
      history.replaceState(null, '', url.pathname + url.search + url.hash);
    }
  }

  function showAccessError(message) {
    const el = document.getElementById('plato-access-error');
    if (!el) return;
    el.hidden = !message;
    el.textContent = message || '';
  }

  function showAccess(hasAccess) {
    const loading = document.getElementById('plato-loading');
    const content = document.getElementById('plato-content');
    const simulator = document.getElementById('plato-simulator');
    const gate = document.getElementById('plato-gate');

    if (loading) loading.hidden = true;
    if (content) content.hidden = false;

    if (hasAccess) {
      if (simulator) simulator.hidden = false;
      if (gate) gate.hidden = true;
      showAccessError('');
    } else {
      if (simulator) simulator.hidden = true;
      if (gate) gate.hidden = false;
    }
  }

  function unlockAccess() {
    setCookie(COOKIE_NAME, 'true', COOKIE_DAYS);
    cleanAccessParams();
    showAccess(true);
  }

  async function init() {
    const params = new URLSearchParams(location.search);
    const sessionId = params.get(PLATO_SESSION_PARAM);
    const accessToken = params.get(PLATO_ACCESS_PARAM);
    const hasCookie = getCookie(COOKIE_NAME) === 'true';

    // Limpiar el viejo bypass aunque no otorgue acceso
    if (params.has(PLATO_PREMIUM_PARAM) && !sessionId && !accessToken && !hasCookie) {
      cleanAccessParams();
    }

    if (hasCookie) {
      cleanAccessParams();
      showAccess(true);
      return;
    }

    if (sessionId) {
      try {
        const res = await fetch('/api/plato/verify-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          unlockAccess();
          return;
        }
        cleanAccessParams();
        showAccess(false);
        showAccessError(
          data.error ||
            'No se pudo confirmar el pago. Si ya pagaste, usa «Ya compré» con tu email.',
        );
        return;
      } catch (err) {
        console.error('plato verify session error:', err);
        cleanAccessParams();
        showAccess(false);
        showAccessError(
          'No se pudo confirmar el pago. Inténtalo de nuevo o usa «Ya compré».',
        );
        return;
      }
    }

    if (accessToken) {
      try {
        const res = await fetch('/api/plato/access', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: accessToken }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          unlockAccess();
          return;
        }
        console.error('plato access token rejected:', data.error);
        cleanAccessParams();
        showAccess(false);
        showAccessError(
          data.error ||
            'Este enlace no es válido. Prueba «Ya compré» con el email del pago.',
        );
        return;
      } catch (err) {
        console.error('plato access token error:', err);
      }
    }

    showAccess(false);
  }

  window.addEventListener('plato:unlock', () => {
    unlockAccess();
  });

  init();
</script>
