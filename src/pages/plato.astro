---
import Layout from '../layouts/Layout.astro';
import PlatoPremiumGate from '../components/PlatoPremiumGate.astro';
import PlatoInteractivo from '../components/PlatoInteractivo.astro';
import {
  PLATO_ACCESS_PARAM,
  PLATO_PREMIUM_COOKIE,
  PLATO_PREMIUM_PARAM,
} from '../lib/plato-config';

/**
 * Comprobación SSR del parámetro en la URL.
 * Si viene ?premium=true se activa el contenido.
 * ?acceso=TOKEN se valida en el cliente contra la API.
 * La cookie se gestiona en el cliente (ver <script> abajo).
 */
const url = new URL(Astro.request.url);
const hasParam = url.searchParams.get(PLATO_PREMIUM_PARAM) === 'true';

/**
 * La comprobación de cookie es client-side. El servidor renderiza
 * el simulador si el parámetro premium está presente; de lo contrario, el
 * <script> lo decide según la cookie / magic link antes de que el usuario vea nada.
 */
const renderSimulator = hasParam;
---

<Layout
  title="Simulador del Plato | Embarazafit"
  description="Construye tu plato 50-25-25 con evidencia científica para controlar la diabetes gestacional. Herramienta premium interactiva."
>
  <style>
    :global(main) {
      max-width: 1000px;
      padding: 0 16px;
    }

    .plato-page {
      padding: 32px 0 56px;
    }

    .plato-header {
      margin-bottom: 32px;
      text-align: center;
    }

    .plato-header__label {
      display: inline-block;
      margin-bottom: 10px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #32a398;
      background: #32a39815;
      border-radius: 20px;
      padding: 3px 14px;
    }

    .plato-header h1 {
      margin: 0 0 10px;
      font-size: clamp(1.5rem, 5vw, 2rem);
      color: #2e3033;
      line-height: 1.2;
    }

    .plato-header p {
      max-width: 540px;
      margin: 0 auto;
      font-size: 1rem;
      line-height: 1.65;
      color: #2e303399;
    }

    /* Loader invisible mientras JS decide */
    #plato-loading {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 220px;
      color: #2e303360;
      font-size: 0.9rem;
    }
  </style>

  <div class="plato-page">
    <header class="plato-header">
      <span class="plato-header__label">⭐ Herramienta Premium</span>
      <h1>Simulador del Plato<br />para Diabetes Gestacional</h1>
      <p>
        Arma tu plato con la estructura 50-25-25 basada en evidencia para
        controlar los picos de glucosa en ayunas y tras las comidas.
      </p>
    </header>

    <!-- Fallback de carga (visible solo el instante antes de que JS corra) -->
    <div id="plato-loading" aria-hidden="true">
      <span>Cargando…</span>
    </div>

    <!-- Contenido real; JS lo muestra con la variante correcta -->
    <div id="plato-content" hidden>
      {
        renderSimulator ? (
          <div id="plato-simulator">
            <PlatoInteractivo />
          </div>
        ) : (
          <>
            {/* Si el servidor no tiene el param, renderizamos ambas variantes
                y JS decide cuál mostrar según la cookie / magic link */}
            <div id="plato-simulator" hidden>
              <PlatoInteractivo />
            </div>
            <div id="plato-gate">
              <PlatoPremiumGate />
            </div>
          </>
        )
      }
    </div>
  </div>
</Layout>

<script
  define:vars={{
    PLATO_PREMIUM_COOKIE,
    PLATO_PREMIUM_PARAM,
    PLATO_ACCESS_PARAM,
    renderSimulator,
  }}
>
  /**
   * Lógica de acceso premium:
   * 1. ?premium=true (Stripe success) → cookie
   * 2. Cookie existente → acceso
   * 3. ?acceso=TOKEN (email) → valida API → cookie
   * 4. Evento plato:unlock (formulario «Ya compré») → cookie
   */

  const COOKIE_NAME = PLATO_PREMIUM_COOKIE;
  const COOKIE_DAYS = 3650; // 10 años ≈ acceso permanente

  function getCookie(name) {
    return document.cookie.split('; ').reduce((acc, pair) => {
      const [k, v] = pair.split('=');
      return k === name ? decodeURIComponent(v) : acc;
    }, '');
  }

  function setCookie(name, value, days) {
    const expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=/; SameSite=Lax`;
  }

  function cleanAccessParams() {
    const url = new URL(location.href);
    let changed = false;
    if (url.searchParams.has(PLATO_PREMIUM_PARAM)) {
      url.searchParams.delete(PLATO_PREMIUM_PARAM);
      changed = true;
    }
    if (url.searchParams.has(PLATO_ACCESS_PARAM)) {
      url.searchParams.delete(PLATO_ACCESS_PARAM);
      changed = true;
    }
    if (changed) {
      history.replaceState(null, '', url.pathname + url.search + url.hash);
    }
  }

  function showAccess(hasAccess) {
    const loading = document.getElementById('plato-loading');
    const content = document.getElementById('plato-content');
    const simulator = document.getElementById('plato-simulator');
    const gate = document.getElementById('plato-gate');

    if (loading) loading.hidden = true;
    if (content) content.hidden = false;

    if (hasAccess) {
      if (simulator) simulator.hidden = false;
      if (gate) gate.hidden = true;
    } else {
      if (simulator) simulator.hidden = true;
      if (gate) gate.hidden = false;
    }
  }

  function unlockAccess() {
    setCookie(COOKIE_NAME, 'true', COOKIE_DAYS);
    cleanAccessParams();
    showAccess(true);
  }

  async function init() {
    const params = new URLSearchParams(location.search);
    const urlParam = params.get(PLATO_PREMIUM_PARAM);
    const accessToken = params.get(PLATO_ACCESS_PARAM);
    const hasCookie = getCookie(COOKIE_NAME) === 'true';

    if (urlParam === 'true' || hasCookie || renderSimulator) {
      if (urlParam === 'true' && !hasCookie) {
        setCookie(COOKIE_NAME, 'true', COOKIE_DAYS);
      }
      cleanAccessParams();
      showAccess(true);
      return;
    }

    if (accessToken) {
      try {
        const res = await fetch('/api/plato/access', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: accessToken }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          unlockAccess();
          return;
        }
        console.error('plato access token rejected:', data.error);
      } catch (err) {
        console.error('plato access token error:', err);
      }
    }

    showAccess(false);
  }

  window.addEventListener('plato:unlock', () => {
    unlockAccess();
  });

  init();
</script>
