---
interface Props {
  permalink: string;
}

const { permalink } = Astro.props;
const reelId = permalink.match(/reel\/([^/?]+)/)?.[1] ?? "";
const embedSrc = `https://www.instagram.com/reel/${reelId}/embed`;
---

<div class="ig-embed">
  <iframe
    src={embedSrc}
    title="Reel de EmbarazaFit en Instagram"
    loading="lazy"
    allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</div>

<style>
  .ig-embed {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .ig-embed iframe {
    width: 100%;
    max-width: 100%;
    height: 520px;
    border: 0;
    display: block;
    margin: 0;
  }
</style>
