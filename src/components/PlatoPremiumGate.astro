---
import {
  PLATO_CHECKOUT_URL,
  PLATO_PREMIUM_AMOUNT,
  PLATO_PREMIUM_CURRENCY,
} from '../lib/plato-config';
---

<section
  class="mx-auto max-w-lg rounded-2xl border border-dusty-rose/60 bg-white p-8 text-center shadow-lg"
  aria-labelledby="plato-gate-title"
>
  <div
    class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-deep-teal/10 text-3xl"
    aria-hidden="true"
  >
    🍽️
  </div>

  <p class="mb-2 text-sm font-bold uppercase tracking-wide text-deep-teal">
    Herramienta premium
  </p>

  <h1
    id="plato-gate-title"
    class="mb-3 text-2xl font-bold leading-tight text-gunmetal"
  >
    Ups, esta herramienta es exclusiva
  </h1>

  <p class="mb-6 text-base leading-relaxed text-gunmetal/80">
    El Simulador del Plato Interactivo te ayuda a armar comidas con la
    proporción 50-25-25 basada en evidencia, para controlar los picos de
    glucosa en ayunas y tras las comidas.
  </p>

  <ul class="mb-8 space-y-3 text-left text-sm text-gunmetal/85">
    <li class="flex gap-3">
      <span class="mt-0.5 text-deep-teal" aria-hidden="true">✓</span>
      <span>Lista oficial de alimentos con índice glucémico</span>
    </li>
    <li class="flex gap-3">
      <span class="mt-0.5 text-deep-teal" aria-hidden="true">✓</span>
      <span>Plato visual interactivo 50 % verduras · 25 % proteína · 25 % carbohidratos</span>
    </li>
    <li class="flex gap-3">
      <span class="mt-0.5 text-deep-teal" aria-hidden="true">✓</span>
      <span>Acceso inmediato tras la compra + enlace por email para otros dispositivos</span>
    </li>
  </ul>

  <a
    href={PLATO_CHECKOUT_URL}
    class="plato-gate-cta"
  >
    <span class="plato-gate-cta-text">Desbloquear por</span>
    <span class="plato-gate-cta-price" aria-label={`${PLATO_PREMIUM_AMOUNT} euros`}>
      <span class="plato-gate-cta-amount">{PLATO_PREMIUM_AMOUNT}</span>
      <span class="plato-gate-cta-currency">{PLATO_PREMIUM_CURRENCY}</span>
    </span>
  </a>

  <p class="mt-4 text-xs text-gunmetal/60">
    Pago único · Te enviamos el acceso por email
  </p>

  <div class="plato-recover">
    <p class="plato-recover-title">¿Ya lo compraste?</p>
    <p class="plato-recover-hint">
      Usa el mismo email del pago. También te reenviamos el enlace de acceso.
    </p>
    <form id="plato-recover-form" class="plato-recover-form">
      <label class="sr-only" for="plato-recover-email">Email de la compra</label>
      <input
        id="plato-recover-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder="Tu email de la compra"
        class="plato-recover-input"
      />
      <button type="submit" class="plato-recover-btn" id="plato-recover-btn">
        Abrir mi acceso
      </button>
    </form>
    <p
      id="plato-recover-msg"
      class="plato-recover-msg"
      role="status"
      aria-live="polite"
      hidden
    ></p>
  </div>
</section>

<style>
  .plato-gate-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    width: 100%;
    padding: 14px 24px;
    border-radius: 9999px;
    background-color: #e85a4a;
    color: #ffffff !important;
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    border-bottom: none;
    box-shadow: 0 2px 8px rgba(232, 90, 74, 0.35);
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
    -webkit-font-smoothing: antialiased;
  }

  .plato-gate-cta-text {
    color: #ffffff;
    letter-spacing: 0.01em;
  }

  .plato-gate-cta-price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    padding: 0.1rem 0.55rem;
    border-radius: 0.5rem;
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }

  .plato-gate-cta-amount {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .plato-gate-cta-currency {
    font-size: 1.1rem;
    font-weight: 800;
    line-height: 1;
    font-family: system-ui, 'Segoe UI', sans-serif;
  }

  .plato-gate-cta:hover {
    background-color: #32a398;
    color: #ffffff !important;
    border-bottom: none;
    box-shadow: 0 2px 8px rgba(50, 163, 152, 0.35);
  }

  .plato-recover {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid rgba(210, 183, 189, 0.55);
    text-align: left;
  }

  .plato-recover-title {
    margin: 0 0 6px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #2e3033;
    text-align: center;
  }

  .plato-recover-hint {
    margin: 0 0 14px;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #2e303399;
    text-align: center;
  }

  .plato-recover-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .plato-recover-input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1.5px solid rgba(46, 48, 51, 0.18);
    border-radius: 10px;
    font-family: inherit;
    font-size: 1rem;
    color: #2e3033;
    background: #fff;
  }

  .plato-recover-input:focus {
    outline: 2px solid #32a398;
    outline-offset: 1px;
    border-color: #32a398;
  }

  .plato-recover-btn {
    width: 100%;
    padding: 12px 18px;
    border: none;
    border-radius: 9999px;
    background-color: #32a398;
    color: #f7f4ef;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .plato-recover-btn:hover:not(:disabled) {
    background-color: #2a8a81;
  }

  .plato-recover-btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .plato-recover-msg {
    margin: 12px 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    text-align: center;
  }

  .plato-recover-msg.is-error {
    color: #b42318;
  }

  .plato-recover-msg.is-ok {
    color: #1a7a4c;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const form = document.getElementById('plato-recover-form');
  const emailInput = document.getElementById('plato-recover-email');
  const btn = document.getElementById('plato-recover-btn');
  const msg = document.getElementById('plato-recover-msg');

  function showMsg(text, ok) {
    if (!msg) return;
    msg.hidden = false;
    msg.textContent = text;
    msg.classList.toggle('is-ok', ok);
    msg.classList.toggle('is-error', !ok);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
    if (!email) {
      showMsg('Introduce el email de la compra.', false);
      return;
    }

    if (btn instanceof HTMLButtonElement) {
      btn.disabled = true;
      btn.textContent = 'Comprobando…';
    }

    try {
      const res = await fetch('/api/plato/access', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        showMsg(
          data.error ||
            'No encontramos una compra con ese email. Revisa que sea el mismo del pago o escríbeme a contacto@embarazafit.com.',
          false,
        );
        return;
      }

      // Avisa a plato.astro para poner cookie y mostrar el simulador
      window.dispatchEvent(new CustomEvent('plato:unlock', { detail: { source: 'email' } }));
      showMsg(
        '¡Listo! Acceso abierto. Te hemos reenviado el enlace por email.',
        true,
      );
    } catch {
      showMsg('No se pudo comprobar el acceso. Inténtalo de nuevo.', false);
    } finally {
      if (btn instanceof HTMLButtonElement) {
        btn.disabled = false;
        btn.textContent = 'Abrir mi acceso';
      }
    }
  });
</script>
