---
import { PLATO_CATEGORIAS, PLATO_NOTAS } from '../data/plato-alimentos';
import PlatoBeneficiosPremium from './PlatoBeneficiosPremium.astro';

const categorias = PLATO_CATEGORIAS;
---

<!-- Simulador -->
<div class="plato-root">
  <!-- ────────────────────────────────────────────
       GRÁFICO DEL PLATO (arriba en mobile, lateral en desktop)
  ──────────────────────────────────────────── -->
  <div class="plato-visual-wrap">
    <!-- SVG plato -->
    <div class="plato-svg-container">
      <svg
        id="plato-svg"
        viewBox="0 0 260 260"
        xmlns="http://www.w3.org/2000/svg"
        aria-label="Representación visual de tu plato"
        role="img"
      >
        <!-- Sombra del plato -->
        <ellipse cx="130" cy="248" rx="100" ry="10" fill="#00000012"/>
        <!-- Plato base -->
        <circle cx="130" cy="128" r="118" fill="#fff" stroke="#d2b7bd" stroke-width="3"/>
        <!-- Segmento Verduras 50% (semicírculo izquierdo) -->
        <path
          id="seg-verduras"
          d="M130 10 A118 118 0 0 0 130 246 L130 128 Z"
          fill="#32a398"
          opacity="0.85"
        />
        <!-- Segmento Proteínas 25% (cuarto superior derecho) -->
        <path
          id="seg-proteinas"
          d="M130 10 A118 118 0 0 1 248 128 L130 128 Z"
          fill="#f76f5e"
          opacity="0.88"
        />
        <!-- Segmento Carbohidratos 25% (cuarto inferior derecho) -->
        <path
          id="seg-carbohidratos"
          d="M248 128 A118 118 0 0 1 130 246 L130 128 Z"
          fill="#d2b7bd"
        />
        <!-- Borde del plato encima de los segmentos -->
        <circle cx="130" cy="128" r="118" fill="none" stroke="#2e303315" stroke-width="2"/>

        <!-- Líneas divisorias -->
        <line x1="130" y1="10" x2="130" y2="246" stroke="#fff" stroke-width="2" opacity="0.6"/>
        <line x1="130" y1="128" x2="248" y2="128" stroke="#fff" stroke-width="2" opacity="0.6"/>

        <!-- Etiquetas de categoría (siempre visibles) -->
        <text x="80" y="130" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="10" font-weight="700">50%</text>
        <text x="80" y="142" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="8">Verduras</text>
        <text x="195" y="80" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="10" font-weight="700">25%</text>
        <text x="195" y="92" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="8">Proteína</text>
        <text x="195" y="178" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="10" font-weight="700">25%</text>
        <text x="195" y="186" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="6.5" font-weight="700">
          <tspan x="195" dy="0">Carbo-</tspan>
          <tspan x="195" dy="7">hidratos</tspan>
        </text>

        <!-- Alimento seleccionado — texto dinámico; se actualiza vía JS -->
        <text id="plato-label-verduras" x="75" y="115" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="7.5" font-weight="700" opacity="0">–</text>
        <text id="plato-label-proteinas" x="195" y="65" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="7.5" font-weight="700" opacity="0">–</text>
        <text id="plato-label-carbohidratos" x="195" y="165" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="7.5" font-weight="700" opacity="0">–</text>
      </svg>
    </div>

    <!-- Resumen del plato seleccionado -->
    <div id="plato-resumen" class="plato-resumen" aria-live="polite">
      <p class="plato-resumen-hint">
        Elige un ingrediente de cada categoría para armar tu plato.
      </p>
    </div>
  </div>

  <!-- ────────────────────────────────────────────
       SELECTOR POR CATEGORÍAS
  ──────────────────────────────────────────── -->
  <div class="plato-selector">
    <!-- Pestañas de categoría -->
    <div class="plato-tabs" role="tablist" aria-label="Categorías del plato">
      {
        categorias.map((cat, i) => (
          <button
            class="plato-tab"
            role="tab"
            id={`tab-${cat.id}`}
            aria-controls={`panel-${cat.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-cat={cat.id}
            data-color={cat.colorClass}
          >
            <span class={`plato-tab-dot ${cat.colorClass}`} aria-hidden="true" />
            <span>{cat.shortLabel}</span>
            <span class="plato-tab-pct">{cat.percentage}%</span>
          </button>
        ))
      }
    </div>

    <!-- Paneles de alimentos -->
    {
      categorias.map((cat, i) => (
        <div
          id={`panel-${cat.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${cat.id}`}
          class="plato-panel"
          hidden={i !== 0}
          data-cat={cat.id}
        >
          <p class="plato-panel-desc">{cat.description}</p>
          <ul class="plato-alimentos-list" role="list">
            {cat.alimentos.map((alimento) => (
              <li>
                <button
                  class="plato-alimento-btn"
                  data-cat={cat.id}
                  data-id={alimento.id}
                  data-name={alimento.name}
                  aria-pressed="false"
                  title={alimento.note ?? alimento.name}
                >
                  <span class="plato-alimento-name">{alimento.name}</span>
                  {alimento.gi !== undefined && (
                    <span class="plato-alimento-gi">IG {alimento.gi}</span>
                  )}
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <!-- Notas al pie -->
    <div class="plato-notas">
      <p>
        <strong>Combinación:</strong>
        {PLATO_NOTAS.combinacion}
      </p>
      <p>
        <strong>Aderezos:</strong>
        {PLATO_NOTAS.aderezos}
      </p>
    </div>
  </div>

  <!-- Bloque de beneficios (debajo en mobile, columna en desktop) -->
  <div class="plato-beneficios">
    <PlatoBeneficiosPremium />
  </div>
</div>

<script>
  // ── ESTADO ─────────────────────────────────────────────
  const selected: Record<string, { id: string; name: string } | null> = {
    verduras: null,
    proteinas: null,
    carbohidratos: null,
  };

  // ── TABS ───────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>('.plato-tab');
  const panels = document.querySelectorAll<HTMLElement>('.plato-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.setAttribute('aria-selected', 'false');
        t.classList.remove('is-active');
      });
      panels.forEach((p) => (p.hidden = true));

      tab.setAttribute('aria-selected', 'true');
      tab.classList.add('is-active');
      const panel = document.getElementById(`panel-${tab.dataset.cat}`);
      if (panel) panel.hidden = false;
    });

    // Activar primer tab visualmente al arrancar
    if (tab.getAttribute('aria-selected') === 'true') {
      tab.classList.add('is-active');
    }
  });

  // ── ALIMENTOS ──────────────────────────────────────────
  const alimentoBtns =
    document.querySelectorAll<HTMLButtonElement>('.plato-alimento-btn');

  alimentoBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat as string;
      const id = btn.dataset.id as string;
      const name = btn.dataset.name as string;

      // Deseleccionar otros en la misma categoría
      document
        .querySelectorAll<HTMLButtonElement>(`.plato-alimento-btn[data-cat="${cat}"]`)
        .forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
          b.classList.remove('is-selected');
        });

      // Toggle: si ya estaba seleccionado, deseleccionar
      if (selected[cat]?.id === id) {
        selected[cat] = null;
        btn.setAttribute('aria-pressed', 'false');
        btn.classList.remove('is-selected');
      } else {
        selected[cat] = { id, name };
        btn.setAttribute('aria-pressed', 'true');
        btn.classList.add('is-selected');
      }

      actualizarPlato();
    });
  });

  // ── ACTUALIZAR PLATO SVG Y RESUMEN ──────────────────────
  function actualizarPlato() {
    const labelMap: Record<string, string> = {
      verduras: 'plato-label-verduras',
      proteinas: 'plato-label-proteinas',
      carbohidratos: 'plato-label-carbohidratos',
    };

    for (const cat of Object.keys(selected)) {
      const el = document.getElementById(labelMap[cat]) as SVGTextElement | null;
      if (!el) continue;

      if (selected[cat]) {
        // Truncar nombre largo para el SVG
        const nombre = selected[cat]!.name;
        const truncado =
          nombre.length > 18 ? nombre.slice(0, 16) + '…' : nombre;
        el.textContent = truncado;
        el.setAttribute('opacity', '1');
      } else {
        el.setAttribute('opacity', '0');
      }
    }

    actualizarResumen();
  }

  function actualizarResumen() {
    const resumen = document.getElementById('plato-resumen');
    if (!resumen) return;

    const items = [
      { cat: 'verduras', label: 'Verdura', pct: '50%' },
      { cat: 'proteinas', label: 'Proteína', pct: '25%' },
      { cat: 'carbohidratos', label: 'Carbohidrato', pct: '25%' },
    ];

    const elegidos = items.filter((i) => selected[i.cat]);
    const total = elegidos.length;

    if (total === 0) {
      resumen.innerHTML =
        '<p class="plato-resumen-hint">Elige un ingrediente de cada categoría para armar tu plato.</p>';
      return;
    }

    let html = '<ul class="plato-resumen-list" aria-label="Tu plato actual">';
    for (const item of items) {
      const alimento = selected[item.cat];
      if (alimento) {
        html += `<li><span class="plato-resumen-pct plato-resumen-pct--${item.cat}">${item.pct} ${item.label}</span> <span class="plato-resumen-name">${alimento.name}</span></li>`;
      }
    }
    html += '</ul>';

    if (total === 3) {
      html +=
        '<p class="plato-resumen-completo">✅ Plato completo y equilibrado para gestionar tu glucosa.</p>';
    } else {
      const faltan = 3 - total;
      html += `<p class="plato-resumen-hint">Aún ${faltan === 1 ? 'falta' : 'faltan'} ${faltan} ${faltan === 1 ? 'categoría' : 'categorías'}.</p>`;
    }

    resumen.innerHTML = html;
  }
</script>

<style>
  /* ── Layout contenedor principal ─────────────────────── */
  .plato-root {
    display: grid;
    grid-template-areas:
      'visual'
      'selector'
      'beneficios';
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .plato-root {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      grid-template-areas:
        'visual selector'
        'beneficios selector';
      gap: 2rem;
    }
  }

  .plato-visual-wrap {
    grid-area: visual;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .plato-selector {
    grid-area: selector;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .plato-beneficios {
    grid-area: beneficios;
  }

  /* ── SVG Plato ───────────────────────────────────────── */
  .plato-svg-container {
    max-width: 280px;
    width: 100%;
    margin: 0 auto;
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.1));
  }

  .plato-svg-container svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Resumen debajo del plato ─────────────────────────── */
  .plato-resumen {
    background: #fff;
    border: 1px solid #d2b7bd66;
    border-radius: 12px;
    padding: 14px 16px;
    min-height: 64px;
    font-size: 0.88rem;
  }

  .plato-resumen-hint {
    margin: 0;
    color: #2e303380;
    font-style: italic;
    font-size: 0.85rem;
  }

  :global(.plato-resumen-list) {
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.plato-resumen-list li) {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  :global(.plato-resumen-pct) {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 20px;
    color: #fff;
    white-space: nowrap;
  }

  :global(.plato-resumen-pct--verduras) {
    background-color: #32a398;
  }

  :global(.plato-resumen-pct--proteinas) {
    background-color: #f76f5e;
  }

  :global(.plato-resumen-pct--carbohidratos) {
    background-color: #c4a0a9;
    color: #2e3033;
  }

  :global(.plato-resumen-name) {
    font-size: 0.88rem;
    color: #2e3033;
  }

  :global(.plato-resumen-completo) {
    margin: 6px 0 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: #32a398;
  }

  /* ── Pestañas ─────────────────────────────────────────── */
  .plato-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 2px solid #d2b7bd55;
    padding-bottom: 0;
  }

  .plato-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 6px;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: #2e303380;
    transition: color 0.2s, border-color 0.2s;
    margin-bottom: -2px;
    border-radius: 8px 8px 0 0;
  }

  .plato-tab:hover {
    color: #2e3033;
    background: #f7f4ef;
  }

  .plato-tab.is-active {
    color: #2e3033;
    border-bottom-color: #32a398;
    background: #fff;
  }

  .plato-tab[data-cat='proteinas'].is-active {
    border-bottom-color: #f76f5e;
  }

  .plato-tab[data-cat='carbohidratos'].is-active {
    border-bottom-color: #d2b7bd;
  }

  .plato-tab-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
    flex-shrink: 0;
  }

  .bg-deep-teal {
    background-color: #32a398;
  }

  .bg-vibrant-coral {
    background-color: #f76f5e;
  }

  .bg-dusty-rose {
    background-color: #d2b7bd;
  }

  .plato-tab-pct {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  /* ── Paneles de alimentos ─────────────────────────────── */
  .plato-panel {
    background: #fff;
    border: 1px solid #d2b7bd44;
    border-radius: 0 0 12px 12px;
    padding: 12px;
  }

  .plato-panel-desc {
    font-size: 0.8rem;
    color: #2e303380;
    margin: 0 0 10px;
    font-style: italic;
    line-height: 1.45;
  }

  .plato-alimentos-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    /* Scroll cómodo en móvil si la lista es larga */
    max-height: 42dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  /* scrollbar discreta */
  .plato-alimentos-list::-webkit-scrollbar {
    width: 4px;
  }

  .plato-alimentos-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .plato-alimentos-list::-webkit-scrollbar-thumb {
    background: #d2b7bd;
    border-radius: 2px;
  }

  .plato-alimento-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 12px;
    background: #f7f4ef;
    border: 2px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    text-align: left;
    transition: background 0.15s, border-color 0.15s;
    -webkit-tap-highlight-color: transparent;
  }

  .plato-alimento-btn:hover,
  .plato-alimento-btn:focus-visible {
    background: #eef7f5;
    border-color: #32a39866;
    outline: none;
  }

  .plato-alimento-btn.is-selected {
    background: #eef7f5;
    border-color: #32a398;
  }

  .plato-panel[data-cat='proteinas'] .plato-alimento-btn.is-selected {
    border-color: #f76f5e;
    background: #fff5f4;
  }

  .plato-panel[data-cat='carbohidratos'] .plato-alimento-btn.is-selected {
    border-color: #c4a0a9;
    background: #fdf8f9;
  }

  .plato-alimento-name {
    font-size: 0.85rem;
    color: #2e3033;
    line-height: 1.35;
  }

  .plato-alimento-gi {
    font-size: 0.75rem;
    font-weight: 700;
    color: #32a398;
    background: #32a39818;
    border-radius: 20px;
    padding: 1px 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Notas al pie del selector ───────────────────────── */
  .plato-notas {
    background: #fff8e6;
    border: 1px solid #f0d78c;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 0.8rem;
    line-height: 1.55;
    color: #2e3033cc;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .plato-notas p {
    margin: 0;
  }
</style>
