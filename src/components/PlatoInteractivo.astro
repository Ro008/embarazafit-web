---
import { PLATO_CATEGORIAS, PLATO_NOTAS } from '../data/plato-alimentos';
import PlatoBeneficiosPremium from './PlatoBeneficiosPremium.astro';

const categorias = PLATO_CATEGORIAS;
---

<!-- Simulador -->
<div class="plato-root">
  <!-- ────────────────────────────────────────────
       GRÁFICO DEL PLATO (arriba en mobile, lateral en desktop)
  ──────────────────────────────────────────── -->
  <div class="plato-visual-wrap">
    <div
      id="plato-safe-badge"
      class="plato-safe-badge"
      hidden
      role="status"
      aria-live="polite"
    >
      ✓ Plato Seguro y Equilibrado
    </div>

    <div id="plato-svg-wrap" class="plato-svg-container">
      <svg
        id="plato-svg"
        viewBox="0 0 260 260"
        xmlns="http://www.w3.org/2000/svg"
        aria-label="Representación visual de tu plato"
        role="img"
      >
        <ellipse cx="130" cy="248" rx="100" ry="10" fill="#00000012"/>
        <circle
          id="plato-ring"
          cx="130"
          cy="128"
          r="118"
          fill="#fff"
          stroke="#d2b7bd"
          stroke-width="3"
        />
        <path
          id="seg-verduras"
          class="plato-seg"
          d="M130 10 A118 118 0 0 0 130 246 L130 128 Z"
          fill="#32a398"
          opacity="0.55"
        />
        <path
          id="seg-proteinas"
          class="plato-seg"
          d="M130 10 A118 118 0 0 1 248 128 L130 128 Z"
          fill="#f76f5e"
          opacity="0.55"
        />
        <path
          id="seg-carbohidratos"
          class="plato-seg"
          d="M248 128 A118 118 0 0 1 130 246 L130 128 Z"
          fill="#d2b7bd"
          opacity="0.55"
        />
        <circle cx="130" cy="128" r="118" fill="none" stroke="#2e303315" stroke-width="2"/>

        <line x1="130" y1="10" x2="130" y2="246" stroke="#fff" stroke-width="2" opacity="0.6"/>
        <line x1="130" y1="128" x2="248" y2="128" stroke="#fff" stroke-width="2" opacity="0.6"/>

        <text x="80" y="130" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="10" font-weight="700">50%</text>
        <text x="80" y="142" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="8">Verduras</text>
        <text x="195" y="80" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="10" font-weight="700">25%</text>
        <text x="195" y="92" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="8">Proteína</text>
        <text x="195" y="178" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="10" font-weight="700">25%</text>
        <text x="195" y="186" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="6.5" font-weight="700">
          <tspan x="195" dy="0">Carbo-</tspan>
          <tspan x="195" dy="7">hidratos</tspan>
        </text>

        <text id="plato-label-verduras" class="plato-food-label" x="75" y="115" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="7.5" font-weight="700" opacity="0">–</text>
        <text id="plato-label-proteinas" class="plato-food-label" x="195" y="65" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="7.5" font-weight="700" opacity="0">–</text>
        <text id="plato-label-carbohidratos" class="plato-food-label" x="195" y="165" text-anchor="middle" fill="#fff" font-family="Poppins,sans-serif" font-size="7.5" font-weight="700" opacity="0">–</text>
      </svg>
    </div>

    <button type="button" id="plato-surprise" class="plato-surprise">
      <span aria-hidden="true">🎲</span>
      ¿Cena rápida? Sorpréndeme
    </button>

    <div id="plato-resumen" class="plato-resumen" aria-live="polite">
      <p class="plato-resumen-hint">
        Elige un ingrediente de cada categoría para armar tu plato.
      </p>
    </div>

    <section
      id="plato-ideas"
      class="plato-ideas"
      hidden
      aria-live="polite"
      aria-labelledby="plato-ideas-title"
    >
      <h2 id="plato-ideas-title" class="plato-ideas-title">
        Ideas rápidas para cocinar este plato
      </h2>
      <ul id="plato-ideas-list" class="plato-ideas-list"></ul>
    </section>
  </div>

  <!-- ────────────────────────────────────────────
       SELECTOR POR CATEGORÍAS
  ──────────────────────────────────────────── -->
  <div class="plato-selector">
    <!-- Pestañas de categoría -->
    <div class="plato-tabs" role="tablist" aria-label="Categorías del plato">
      {
        categorias.map((cat, i) => (
          <button
            class="plato-tab"
            role="tab"
            id={`tab-${cat.id}`}
            aria-controls={`panel-${cat.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-cat={cat.id}
            data-color={cat.colorClass}
          >
            <span class={`plato-tab-dot ${cat.colorClass}`} aria-hidden="true" />
            <span>{cat.shortLabel}</span>
            <span class="plato-tab-pct">{cat.percentage}%</span>
          </button>
        ))
      }
    </div>

    <!-- Paneles de alimentos -->
    {
      categorias.map((cat, i) => (
        <div
          id={`panel-${cat.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${cat.id}`}
          class="plato-panel"
          hidden={i !== 0}
          data-cat={cat.id}
        >
          <p class="plato-panel-desc">{cat.description}</p>
          <ul class="plato-alimentos-list" role="list">
            {cat.alimentos.map((alimento) => (
              <li>
                <button
                  class="plato-alimento-btn"
                  data-cat={cat.id}
                  data-id={alimento.id}
                  data-name={alimento.name}
                  aria-pressed="false"
                  title={alimento.note ?? alimento.name}
                >
                  <span class="plato-alimento-name">{alimento.name}</span>
                  {alimento.gi !== undefined && (
                    <span class="plato-alimento-gi">IG {alimento.gi}</span>
                  )}
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <!-- Notas al pie -->
    <div class="plato-notas">
      <p>
        <strong>Aderezos:</strong>
        {PLATO_NOTAS.aderezos}
      </p>
    </div>
  </div>

  <!-- Bloque de beneficios (debajo en mobile, columna en desktop) -->
  <div class="plato-beneficios">
    <PlatoBeneficiosPremium />
  </div>

  <!-- CTA fijo: la usuaria suele estar abajo eligiendo alimentos al completar el plato -->
  <div id="plato-ideas-bar" class="plato-ideas-bar" hidden>
    <button type="button" id="plato-ideas-cta" class="plato-ideas-cta">
      ¡Plato completo! Ver ideas de cocina
    </button>
  </div>

  <footer class="plato-feedback">
    <p class="plato-feedback-title">
      💬 ¿Quieres sugerir una mejora o algo no funciona como debería?
    </p>
    <p class="plato-feedback-text">
      Como esta herramienta la he diseñado a mano para ayudarte, tu opinión me
      importa mucho. Si echas en falta algún alimento o notas que algo no va
      bien, escríbeme directamente a
      <a href="mailto:contacto@embarazafit.com">contacto@embarazafit.com</a>
      y lo reviso en cuanto pueda.
    </p>
  </footer>
</div>

<script>
  import { PLATO_CATEGORIAS, getAlimentoById } from '../data/plato-alimentos';
  import {
    PLATO_COMBINACIONES,
    findRecetasForSelection,
    type PlatoCombinacion,
  } from '../data/plato-recetas';

  const selected: Record<string, { id: string; name: string } | null> = {
    verduras: null,
    proteinas: null,
    carbohidratos: null,
  };

  /** Cola barajada de combinaciones con receta; al vaciarse, «Sorpréndeme» pasa a aleatorio total */
  let surpriseRecipeQueue: PlatoCombinacion[] = [];
  let surpriseRecipesExhausted = false;

  function shuffleInPlace<T>(arr: T[]): T[] {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function refillSurpriseRecipeQueue() {
    surpriseRecipeQueue = shuffleInPlace([...PLATO_COMBINACIONES]);
  }

  const labelMap: Record<string, string> = {
    verduras: 'plato-label-verduras',
    proteinas: 'plato-label-proteinas',
    carbohidratos: 'plato-label-carbohidratos',
  };

  const segMap: Record<string, string> = {
    verduras: 'seg-verduras',
    proteinas: 'seg-proteinas',
    carbohidratos: 'seg-carbohidratos',
  };

  // ── TABS ───────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>('.plato-tab');
  const panels = document.querySelectorAll<HTMLElement>('.plato-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.setAttribute('aria-selected', 'false');
        t.classList.remove('is-active');
      });
      panels.forEach((p) => (p.hidden = true));

      tab.setAttribute('aria-selected', 'true');
      tab.classList.add('is-active');
      const panel = document.getElementById(`panel-${tab.dataset.cat}`);
      if (panel) panel.hidden = false;
    });

    if (tab.getAttribute('aria-selected') === 'true') {
      tab.classList.add('is-active');
    }
  });

  function clearCategoryButtons(cat: string) {
    document
      .querySelectorAll<HTMLButtonElement>(
        `.plato-alimento-btn[data-cat="${cat}"]`,
      )
      .forEach((b) => {
        b.setAttribute('aria-pressed', 'false');
        b.classList.remove('is-selected');
      });
  }

  function markButtonSelected(cat: string, id: string) {
    clearCategoryButtons(cat);
    const btn = document.querySelector<HTMLButtonElement>(
      `.plato-alimento-btn[data-cat="${cat}"][data-id="${id}"]`,
    );
    if (!btn) return;
    btn.setAttribute('aria-pressed', 'true');
    btn.classList.add('is-selected');
  }

  /** Selección programática (clic o sorpresa). */
  function setSeleccion(
    cat: string,
    id: string,
    name: string,
    opts: { animate?: boolean; toggleOff?: boolean } = {},
  ) {
    const { animate = true, toggleOff = false } = opts;

    if (toggleOff && selected[cat]?.id === id) {
      selected[cat] = null;
      clearCategoryButtons(cat);
      actualizarPlato({ animateLabels: false });
      return;
    }

    selected[cat] = { id, name };
    markButtonSelected(cat, id);
    actualizarPlato({ animateLabels: animate, animateCat: cat });
  }

  document
    .querySelectorAll<HTMLButtonElement>('.plato-alimento-btn')
    .forEach((btn) => {
      btn.addEventListener('click', () => {
        setSeleccion(
          btn.dataset.cat as string,
          btn.dataset.id as string,
          btn.dataset.name as string,
          { toggleOff: true },
        );
      });
    });

  function popLabel(el: SVGTextElement) {
    el.classList.remove('is-pop');
    void el.getBoundingClientRect();
    el.classList.add('is-pop');
    window.setTimeout(() => el.classList.remove('is-pop'), 400);
  }

  function actualizarPlato(opts: {
    animateLabels?: boolean;
    animateCat?: string;
  } = {}) {
    const { animateLabels = true, animateCat } = opts;

    for (const cat of Object.keys(selected)) {
      const el = document.getElementById(
        labelMap[cat],
      ) as SVGTextElement | null;
      const seg = document.getElementById(segMap[cat]);
      if (!el) continue;

      if (selected[cat]) {
        const nombre = selected[cat]!.name;
        const truncado =
          nombre.length > 18 ? nombre.slice(0, 16) + '…' : nombre;
        const changed = el.textContent !== truncado;
        el.textContent = truncado;
        el.setAttribute('opacity', '1');
        seg?.classList.add('is-filled');
        if (
          animateLabels &&
          changed &&
          (!animateCat || animateCat === cat)
        ) {
          popLabel(el);
        }
      } else {
        el.textContent = '–';
        el.setAttribute('opacity', '0');
        el.classList.remove('is-pop');
        seg?.classList.remove('is-filled');
      }
    }

    actualizarSafeState();
    actualizarResumen();
    actualizarIdeas();
  }

  function actualizarSafeState() {
    const complete = Boolean(
      selected.verduras && selected.proteinas && selected.carbohidratos,
    );
    const wrap = document.getElementById('plato-svg-wrap');
    const badge = document.getElementById('plato-safe-badge');
    const ring = document.getElementById('plato-ring');

    wrap?.classList.toggle('is-complete', complete);
    if (badge) {
      const wasHidden = badge.hidden;
      badge.hidden = !complete;
      if (complete && wasHidden) {
        badge.classList.remove('is-pop');
        void badge.offsetWidth;
        badge.classList.add('is-pop');
      }
    }
    if (ring) {
      ring.setAttribute('stroke', complete ? '#32a398' : '#d2b7bd');
      ring.setAttribute('stroke-width', complete ? '5' : '3');
    }
  }

  function actualizarResumen() {
    const resumen = document.getElementById('plato-resumen');
    if (!resumen) return;

    const items = [
      { cat: 'verduras', label: 'Verdura', pct: '50%' },
      { cat: 'proteinas', label: 'Proteína', pct: '25%' },
      { cat: 'carbohidratos', label: 'Carbohidrato', pct: '25%' },
    ];

    const elegidos = items.filter((i) => selected[i.cat]);
    const total = elegidos.length;

    if (total === 0) {
      resumen.innerHTML =
        '<p class="plato-resumen-hint">Elige un ingrediente de cada categoría para armar tu plato.</p>';
      return;
    }

    let html = '<ul class="plato-resumen-list" aria-label="Tu plato actual">';
    for (const item of items) {
      const alimento = selected[item.cat];
      if (alimento) {
        html += `<li><span class="plato-resumen-pct plato-resumen-pct--${item.cat}">${item.pct} ${item.label}</span> <span class="plato-resumen-name">${escapeHtml(alimento.name)}</span></li>`;
      }
    }
    html += '</ul>';

    if (total < 3) {
      const faltan = 3 - total;
      html += `<p class="plato-resumen-hint">Aún ${faltan === 1 ? 'falta' : 'faltan'} ${faltan} ${faltan === 1 ? 'categoría' : 'categorías'}.</p>`;
    }

    resumen.innerHTML = html;
  }

  function escapeHtml(text: string) {
    return text
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function actualizarIdeas() {
    const section = document.getElementById('plato-ideas');
    const list = document.getElementById('plato-ideas-list');
    const bar = document.getElementById('plato-ideas-bar');
    if (!section || !list || !bar) return;

    const verdura = selected.verduras;
    const proteina = selected.proteinas;
    const carbo = selected.carbohidratos;

    if (!verdura || !proteina || !carbo) {
      section.hidden = true;
      section.classList.remove('is-highlight');
      list.innerHTML = '';
      bar.hidden = true;
      return;
    }

    const { recetas, source } = findRecetasForSelection({
      verdura: verdura.id,
      proteina: proteina.id,
      carbohidrato: carbo.id,
    });

    if (source !== 'match' || recetas.length === 0) {
      section.hidden = true;
      section.classList.remove('is-highlight');
      list.innerHTML = '';
      bar.hidden = true;
      return;
    }

    const titleEl = document.getElementById('plato-ideas-title');
    if (titleEl) {
      titleEl.textContent = 'Ideas rápidas para cocinar este plato';
    }

    list.innerHTML = recetas
      .map((receta) => {
        return `<li class="plato-idea">
          <p class="plato-idea-title">${escapeHtml(receta.title)}</p>
          <p class="plato-idea-tip">${escapeHtml(receta.tip)}</p>
        </li>`;
      })
      .join('');
    section.hidden = false;
    bar.hidden = false;
  }

  function irAIdeas() {
    const section = document.getElementById('plato-ideas');
    const bar = document.getElementById('plato-ideas-bar');
    if (!section) return;

    section.hidden = false;
    section.scrollIntoView({ behavior: 'smooth', block: 'center' });
    section.classList.remove('is-highlight');
    void section.offsetWidth;
    section.classList.add('is-highlight');
    if (bar) bar.hidden = true;
  }

  function aplicarCombinacion(combo: {
    verdura: string;
    proteina: string;
    carbohidrato: string;
  }) {
    const picks = [
      { cat: 'verduras' as const, id: combo.verdura },
      { cat: 'proteinas' as const, id: combo.proteina },
      { cat: 'carbohidratos' as const, id: combo.carbohidrato },
    ];
    for (const { cat, id } of picks) {
      const alimento = getAlimentoById(cat, id);
      if (!alimento) continue;
      selected[cat] = { id: alimento.id, name: alimento.name };
      markButtonSelected(cat, alimento.id);
    }
  }

  function sorprenderAleatorioTotal() {
    for (const cat of PLATO_CATEGORIAS) {
      const pool = cat.alimentos;
      const pick = pool[Math.floor(Math.random() * pool.length)];
      if (!pick) continue;
      selected[cat.id] = { id: pick.id, name: pick.name };
      markButtonSelected(cat.id, pick.id);
    }
  }

  function sorprender() {
    if (!surpriseRecipesExhausted) {
      if (surpriseRecipeQueue.length === 0) {
        refillSurpriseRecipeQueue();
      }
      const combo = surpriseRecipeQueue.pop();
      if (combo) {
        aplicarCombinacion(combo);
        if (surpriseRecipeQueue.length === 0) {
          surpriseRecipesExhausted = true;
        }
      } else {
        surpriseRecipesExhausted = true;
        sorprenderAleatorioTotal();
      }
    } else {
      sorprenderAleatorioTotal();
    }

    actualizarPlato({ animateLabels: false });
    for (const cat of Object.keys(selected)) {
      const el = document.getElementById(
        labelMap[cat],
      ) as SVGTextElement | null;
      if (el && selected[cat]) popLabel(el);
    }
    window.setTimeout(() => {
      const bar = document.getElementById('plato-ideas-bar');
      if (bar && !bar.hidden) irAIdeas();
    }, 320);
  }

  document
    .getElementById('plato-ideas-cta')
    ?.addEventListener('click', irAIdeas);
  document
    .getElementById('plato-surprise')
    ?.addEventListener('click', sorprender);
</script>

<style>
  /* ── Layout contenedor principal ─────────────────────── */
  .plato-root {
    display: grid;
    grid-template-areas:
      'visual'
      'selector'
      'beneficios'
      'feedback';
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .plato-root {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto;
      grid-template-areas:
        'visual selector'
        'beneficios selector'
        'feedback feedback';
      gap: 2rem;
    }
  }

  .plato-visual-wrap {
    grid-area: visual;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .plato-selector {
    grid-area: selector;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .plato-beneficios {
    grid-area: beneficios;
  }

  .plato-ideas {
    background: #fff;
    border: 1px solid rgba(50, 163, 152, 0.28);
    border-left: 4px solid #32a398;
    border-radius: 12px;
    padding: 16px 18px;
    scroll-margin-top: 88px;
  }

  .plato-ideas.is-highlight {
    animation: plato-ideas-pulse 1.2s ease;
  }

  @keyframes plato-ideas-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(50, 163, 152, 0.45);
    }
    40% {
      box-shadow: 0 0 0 6px rgba(50, 163, 152, 0.2);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(50, 163, 152, 0);
    }
  }

  .plato-ideas-title {
    margin: 0 0 12px;
    font-size: 1.05rem;
    font-weight: 700;
    color: #2e3033;
    line-height: 1.35;
  }

  .plato-ideas-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  :global(.plato-idea) {
    padding: 12px 14px;
    background: #f7f4ef;
    border-radius: 10px;
  }

  :global(.plato-idea-title) {
    margin: 0 0 6px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #32a398;
    line-height: 1.35;
  }

  :global(.plato-idea-tip) {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #2e3033cc;
  }

  .plato-ideas-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: linear-gradient(
      to top,
      rgba(247, 244, 239, 0.98) 60%,
      rgba(247, 244, 239, 0)
    );
    pointer-events: none;
  }

  .plato-ideas-cta {
    pointer-events: auto;
    display: block;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    padding: 14px 18px;
    border: none;
    border-radius: 9999px;
    background: #32a398;
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(50, 163, 152, 0.35);
    -webkit-tap-highlight-color: transparent;
  }

  .plato-ideas-cta:hover,
  .plato-ideas-cta:focus-visible {
    background: #2a8a81;
    outline: none;
  }

  /* Espacio para que el CTA fijo no tape el feedback */
  .plato-root:has(#plato-ideas-bar:not([hidden])) {
    padding-bottom: 72px;
  }

  .plato-feedback {
    grid-area: feedback;
    background: #fff;
    border: 1px solid #d2b7bd55;
    border-radius: 12px;
    padding: 16px 18px;
  }

  .plato-feedback-title {
    margin: 0 0 8px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #2e3033;
    line-height: 1.4;
  }

  .plato-feedback-text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: #2e3033cc;
  }

  .plato-feedback-text a {
    font-weight: 700;
    word-break: break-word;
  }

  /* ── SVG Plato ───────────────────────────────────────── */
  .plato-svg-container {
    max-width: 280px;
    width: 100%;
    margin: 0 auto;
    padding: 10px;
