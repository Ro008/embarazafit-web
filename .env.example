# Copia este archivo a .env y rellena los valores ( .env no se sube a GitHub )
# Guía completa: docs/CONSULTA-NUTRICIONISTA.md

# Emails (consulta nutricionista)
NOTIFICATION_EMAIL=
# Email de María (consulta nutricionista). No subir el valor real al repo — solo .env / Vercel.
MARIA_NUTRICIONISTA_EMAIL=

# Mailrelay (API → Configuración en tu panel Mailrelay)
MAILRELAY_API_URL=
MAILRELAY_API_KEY=
MAILRELAY_FROM_EMAIL=
MAILRELAY_FROM_NAME=Embarazafit
# Opcional: IDs de grupos Mailrelay para la newsletter del menú (por defecto: 1 = Default)
# MAILRELAY_NEWSLETTER_GROUP_IDS=1

# Supabase (Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard privado (/dashboard)
ADMIN_PASSWORD=

# Monitorización del formulario (Vercel Cron + alertas)
# Genera una cadena larga aleatoria. Vercel la envía como Bearer al cron.
CRON_SECRET=
